NEXT_PUBLIC_API_URL=http://localhost:8080
# Battles and matchmaking run on the Go API. Set to 0 to play offline against a
# browser-side simulation instead (no two-player matches).
NEXT_PUBLIC_LIVE_BATTLE=
# Privy app ID. Leave unset to use the built-in demo sign-in (any 6-digit code works).
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: use only verified Metaplex Core Devnet test cards in the loadout.
# NEXT_PUBLIC_COLLECTION_SOURCE=devnet
# DEVNET_RPC_URL=https://api.devnet.solana.com
# DEVNET_TEST_COLLECTION_ID=
# DEVNET_TEST_PIKACHU_ASSET=
# DEVNET_TEST_CHARMANDER_ASSET=

# Optional: discover all owned NFTs in approved collections instead of the two
# explicitly configured Core assets. Keep this RPC URL server-only.
# DAS_RPC_URL=
# APPROVED_COLLECTION_IDS=

# Go API environment (set in the API terminal, not a Next public variable):
# PLAYER_STORE_PATH=data/players.json
# GAME_STORE_PATH=data/games.json        # live matches, queues and entry terms
# RESULT_STORE_PATH=data/results.json    # signed final results
# REFEREE_KEY_PATH=data/referee.key      # private Ed25519 seed; never commit or serve
