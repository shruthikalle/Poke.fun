NEXT_PUBLIC_API_URL=http://localhost:8080
# Battles and matchmaking run on the Go API. Set to 0 to play offline against a
# browser-side simulation instead (no two-player matches).
NEXT_PUBLIC_LIVE_BATTLE=
# Privy app ID for real email sign-in. Leave unset for verified Phantom sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=

# Owned cards always come from the Go marketplace index; no generated wallet inventory.
# DEVNET_RPC_URL and the minting key below are Go API settings, never public browser values.

# On-chain marketplace (devnet program, read through the Go API's /api/market).
# NEXT_PUBLIC_MARKET_PROGRAM_ID=           # defaults to the address in lib/market/pokefun_market.idl.json
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Go API environment (set in the API terminal, not a Next public variable):
# MARKET_PROGRAM_ID=                       # enables /api/market
# MARKET_RPC_URL=https://api.devnet.solana.com
# MARKET_STORE_PATH=data/market.json
# MARKET_MINTER_KEYPAIR=/private/path/minter.json  # collection update authority; server only
# MARKET_MINT_COLLECTION=                        # approved Metaplex Core collection
# MARKET_FAUCET_SOL=0.25                         # 0 disables SOL grants
# DEVNET_TEST_COLLECTION_ID=                     # optional additional battle collection
# PLAYER_STORE_PATH=data/players.json
# GAME_STORE_PATH=data/games.json        # live matches, queues and entry terms
# RESULT_STORE_PATH=data/results.json    # signed final results
# REFEREE_KEY_PATH=data/referee.key      # private Ed25519 seed; never commit or serve

# Native Devnet SOL wagers use this separate on-chain referee key on the Next server.
# Never prefix it with NEXT_PUBLIC_ or commit the key file.
# POKEFUN_REFEREE_KEYPAIR=/private/tmp/pokefun-wager-referee.json
# ARENA_API_URL=http://localhost:8080
